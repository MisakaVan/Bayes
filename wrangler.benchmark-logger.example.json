{
  "name": "oem-benchmark-logger",
  "main": "benchmark/tail.ts",
  "compatibility_date": "2026-07-22",
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "OEM_ERR",
      "database_name": "oem-benchmark-errors",
      "database_id": "REPLACE_BENCHMARK_ERRORS_ID",
      "migrations_dir": "oem-logger/migrations"
    },
    {
      "binding": "BENCHMARK_METRICS",
      "database_name": "oem-benchmark-metrics",
      "database_id": "REPLACE_BENCHMARK_METRICS_ID",
      "migrations_dir": "benchmark/migrations"
    }
  ],
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  }
}
